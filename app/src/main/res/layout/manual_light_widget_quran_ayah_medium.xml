<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android='http://schemas.android.com/apk/res/android' android:id='@+id/quran_widget_row' android:layout_height='wrap_content' android:layout_width='match_parent' android:orientation='vertical' android:paddingBottom='9dp' android:paddingHorizontal='9dp' android:paddingTop='11dp'>
    <TextView android:fallbackLineSpacing='true' android:fontFamily='@font/uthmani_hafs' android:gravity='right' android:id='@+id/quran_widget_ayah_text' android:includeFontPadding='false' android:layout_height='wrap_content' android:layout_width='match_parent' android:lineSpacingMultiplier='1.10' android:textColor='#172033' android:textDirection='rtl' android:textSize='27sp'/>
    <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:id='@+id/quran_widget_translation' android:textDirection='ltr' android:gravity='left' android:layout_height='wrap_content' android:layout_width='match_parent' android:lineSpacingExtra='3dp' android:paddingTop='6dp' android:textColor='#737B89' android:textSize='13sp' android:visibility='gone'/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:gravity='right' android:id='@+id/quran_widget_ayah_reference' android:layout_height="wrap_content" android:layout_width="0dp" android:layout_weight="1" android:paddingTop='3dp' android:textColor='#3D7BD9' android:textSize='10sp'/>
        <ImageButton android:id="@+id/quran_widget_ayah_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/manual_light_quran_widget_icon_touch" android:src="@drawable/ic_widget_play" android:contentDescription="Play ayah" />
    </LinearLayout>
    <TextView android:background='@drawable/manual_light_quran_widget_divider' android:layout_height='1dp' android:layout_marginTop='9dp' android:layout_width='match_parent'/>
</LinearLayout>
