<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android='http://schemas.android.com/apk/res/android' android:background='@drawable/manual_dark_quran_widget_background' android:id='@+id/note_widget_root' android:layout_height='match_parent' android:layout_width='match_parent' android:orientation='vertical' android:padding='11dp'>

    <LinearLayout android:gravity='center_vertical' android:layout_height='wrap_content' android:layout_width='match_parent' android:orientation='horizontal'>
        <ImageView android:contentDescription='@null' android:layout_height='18dp' android:layout_width='18dp' android:src='@drawable/manual_dark_ic_widget_note'/>
        <TextView android:fontFamily='@font/plus_jakarta_sans_semi_bold' android:layout_height='wrap_content' android:layout_marginStart='7dp' android:layout_weight='1' android:layout_width='0dp' android:text='@string/note_widget_eyebrow' android:textColor='#B8BBC2' android:textSize='9sp'/>
        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:contentDescription='@string/note_widget_settings' android:id='@+id/note_widget_settings' android:layout_height='34dp' android:layout_width='34dp' android:padding='8dp' android:src='@drawable/manual_dark_ic_widget_settings'/>
    </LinearLayout>
    <TextView android:ellipsize='end' android:fontFamily='@font/plus_jakarta_sans_semi_bold' android:id='@+id/note_widget_title' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#F3F1EC' android:textSize='14sp'/>
    <TextView android:ellipsize='end' android:fontFamily='@font/plus_jakarta_sans_medium' android:id='@+id/note_widget_context' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#B8BBC2' android:textSize='10sp' android:visibility='gone'/>
    <ImageView android:background='@drawable/manual_dark_note_widget_divider' android:contentDescription='@null' android:layout_height='1dp' android:layout_marginTop='7dp' android:layout_width='match_parent'/>
    <ListView android:clipToPadding='false' android:divider='@null' android:id='@+id/note_widget_body' android:layout_height='0dp' android:layout_marginTop='5dp' android:layout_weight='1' android:layout_width='match_parent' android:overScrollMode='never' android:scrollbars='none'/>
    <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:gravity='center' android:id='@+id/note_widget_empty' android:layout_height='0dp' android:layout_weight='1' android:layout_width='match_parent' android:padding='8dp' android:text='@string/note_widget_choose_another' android:textColor='#B8BBC2' android:textSize='12sp' android:visibility='gone'/>
</LinearLayout>
