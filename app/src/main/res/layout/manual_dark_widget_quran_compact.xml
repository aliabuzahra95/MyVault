<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android='http://schemas.android.com/apk/res/android' android:background='@drawable/manual_dark_quran_widget_background' android:clipToOutline='true' android:id='@android:id/background' android:layout_height='match_parent' android:layout_width='match_parent' android:orientation='vertical' android:padding='8dp'>

    <LinearLayout android:gravity='center_vertical' android:layout_height='40dp' android:layout_width='match_parent' android:orientation='horizontal'>

        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_previous' android:layout_height='40dp' android:layout_width='40dp' android:padding='9dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_chevron_left'/>

        <LinearLayout android:gravity='center' android:id='@+id/quran_widget_title_group' android:layout_height='match_parent' android:layout_weight='1' android:layout_width='0dp' android:orientation='vertical' android:paddingHorizontal='3dp'>

            <TextView android:ellipsize='end' android:fontFamily='@font/plus_jakarta_sans_semi_bold' android:gravity='center' android:id='@+id/quran_widget_title' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#F3F1EC' android:textSize='14sp'/>

            <TextView android:fontFamily='@font/uthmani_hafs' android:gravity='center' android:id='@+id/quran_widget_arabic_title' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#B8BBC2' android:textDirection='rtl' android:textSize='17sp' android:visibility='gone'/>
        </LinearLayout>

        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_next' android:layout_height='40dp' android:layout_width='40dp' android:padding='9dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_chevron_right'/>

        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_settings' android:layout_height='40dp' android:layout_width='40dp' android:padding='10dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_settings'/>

        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_open' android:layout_height='40dp' android:layout_width='40dp' android:padding='10dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_open'/>
    </LinearLayout>

    <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:gravity='center' android:id='@+id/quran_widget_metadata' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#8CB5F5' android:textSize='10sp' android:visibility='gone'/>

    <ListView android:clipToPadding='false' android:divider='@android:color/transparent' android:dividerHeight='0dp' android:fadeScrollbars='true' android:id='@+id/quran_widget_collection' android:layout_height='0dp' android:layout_weight='1' android:layout_width='match_parent' android:overScrollMode='never' android:scrollbars='vertical'/>

    <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:gravity='center' android:id='@+id/quran_widget_empty' android:layout_height='0dp' android:layout_weight='1' android:layout_width='match_parent' android:padding='10dp' android:text='@string/quran_widget_unavailable' android:textColor='#B8BBC2' android:textSize='12sp'/>
</LinearLayout>
