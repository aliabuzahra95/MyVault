<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android='http://schemas.android.com/apk/res/android' android:background='@drawable/manual_dark_quran_widget_background' android:clipToOutline='true' android:id='@android:id/background' android:layout_height='match_parent' android:layout_width='match_parent' android:orientation='vertical' android:padding='18dp'>

    <LinearLayout android:gravity='center_vertical' android:layout_height='60dp' android:layout_width='match_parent' android:orientation='horizontal'>
        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_previous' android:layout_height='48dp' android:layout_width='48dp' android:padding='12dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_chevron_left'/>
        <LinearLayout android:gravity='center' android:id='@+id/quran_widget_title_group' android:layout_height='match_parent' android:layout_weight='1' android:layout_width='0dp' android:orientation='vertical' android:paddingHorizontal='8dp'>
            <TextView android:ellipsize='end' android:fontFamily='@font/plus_jakarta_sans_semi_bold' android:gravity='center' android:id='@+id/quran_widget_title' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#F3F1EC' android:textSize='17sp'/>
            <TextView android:fontFamily='@font/uthmani_hafs' android:gravity='center' android:id='@+id/quran_widget_arabic_title' android:includeFontPadding='false' android:layout_height='wrap_content' android:layout_width='match_parent' android:maxLines='1' android:textColor='#B8BBC2' android:textDirection='rtl' android:textSize='23sp'/>
        </LinearLayout>
        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_next' android:layout_height='48dp' android:layout_width='48dp' android:padding='12dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_chevron_right'/>
        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_settings' android:layout_height='48dp' android:layout_width='48dp' android:padding='13dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_settings'/>
        <ImageButton android:background='@drawable/manual_dark_quran_widget_icon_touch' android:id='@+id/quran_widget_open' android:layout_height='48dp' android:layout_width='48dp' android:padding='13dp' android:scaleType='centerInside' android:src='@drawable/manual_dark_ic_widget_open'/>
    </LinearLayout>
    <LinearLayout android:id="@+id/quran_widget_audio_controls" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:gravity='center' android:id='@+id/quran_widget_metadata' android:layout_height="wrap_content" android:layout_width="0dp" android:layout_weight="1" android:maxLines='1' android:textColor='#8CB5F5' android:textSize='12sp'/>
        <ImageButton android:id="@+id/quran_widget_play_surah" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/manual_dark_quran_widget_icon_touch" android:src="@android:drawable/ic_media_play" android:contentDescription="Play Surah" />
        <ImageButton android:id="@+id/quran_widget_continue" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/manual_dark_quran_widget_icon_touch" android:src="@android:drawable/ic_media_next" android:contentDescription="Continue Surah" />
        <ImageButton android:id="@+id/quran_widget_stop" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/manual_dark_quran_widget_icon_touch" android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="Stop recitation" />
    </LinearLayout>
    <TextView android:background='@drawable/manual_dark_quran_widget_divider' android:layout_height='1dp' android:layout_width='match_parent'/>
    <ListView android:clipToPadding='false' android:divider='@android:color/transparent' android:dividerHeight='0dp' android:fadeScrollbars='true' android:id='@+id/quran_widget_collection' android:layout_height='0dp' android:layout_weight='1' android:layout_width='match_parent' android:overScrollMode='never' android:scrollbars='vertical'/>
    <TextView android:fontFamily='@font/plus_jakarta_sans_medium' android:gravity='center' android:id='@+id/quran_widget_empty' android:layout_height='0dp' android:layout_weight='1' android:layout_width='match_parent' android:padding='18dp' android:text='@string/quran_widget_unavailable' android:textColor='#B8BBC2' android:textSize='14sp'/>
</LinearLayout>
