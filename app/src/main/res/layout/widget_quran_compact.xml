<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quran_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/quran_widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/quran_widget_icon_touch"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_left" />

        <LinearLayout
            android:id="@+id/quran_widget_title_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="3dp">

            <TextView
                android:id="@+id/quran_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/quran_widget_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/quran_widget_arabic_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/uthmani_hafs"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/quran_widget_secondary"
                android:textDirection="rtl"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/quran_widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/quran_widget_icon_touch"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_right" />

        <ImageButton
            android:id="@+id/quran_widget_open"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/quran_widget_icon_touch"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_open" />
    </LinearLayout>

    <TextView
        android:id="@+id/quran_widget_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/quran_widget_accent"
        android:textSize="10sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/quran_widget_collection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fadeScrollbars="true"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/quran_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/quran_widget_unavailable"
        android:textColor="@color/quran_widget_secondary"
        android:textSize="12sp" />
</LinearLayout>
