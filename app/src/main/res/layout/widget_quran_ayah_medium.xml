<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/quran_widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="9dp" android:paddingTop="11dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/quran_widget_ayah_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/uthmani_hafs" android:gravity="right" android:includeFontPadding="false" android:lineSpacingExtra="7dp" android:textColor="@color/quran_widget_text" android:textDirection="rtl" android:textSize="27sp" />
    <TextView android:id="@+id/quran_widget_translation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textDirection="ltr" android:gravity="left" android:fontFamily="@font/plus_jakarta_sans_medium" android:lineSpacingExtra="3dp" android:paddingTop="6dp" android:textColor="@color/quran_widget_secondary" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/quran_widget_ayah_reference" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_medium" android:gravity="right" android:paddingTop="3dp" android:textColor="@color/quran_widget_accent" android:textSize="10sp" />
        <ImageButton android:id="@+id/quran_widget_ayah_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:background="@drawable/quran_widget_icon_touch" android:src="@android:drawable/ic_media_play" android:contentDescription="Play ayah" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="9dp" android:background="@drawable/quran_widget_divider" />
</LinearLayout>
