<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/note_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quran_widget_background"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_widget_note" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:fontFamily="@font/plus_jakarta_sans_semi_bold" android:text="@string/note_widget_eyebrow" android:textColor="@color/quran_widget_secondary" android:textSize="9sp" />
        <ImageButton android:id="@+id/note_widget_settings" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/quran_widget_icon_touch" android:contentDescription="@string/note_widget_settings" android:padding="8dp" android:src="@drawable/ic_widget_settings" />
    </LinearLayout>
    <TextView android:id="@+id/note_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/plus_jakarta_sans_semi_bold" android:maxLines="1" android:textColor="@color/quran_widget_text" android:textSize="14sp" />
    <TextView android:id="@+id/note_widget_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/plus_jakarta_sans_medium" android:maxLines="1" android:textColor="@color/quran_widget_secondary" android:textSize="10sp" android:visibility="gone" />
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="@drawable/note_widget_divider" android:contentDescription="@null" />
    <ListView android:id="@+id/note_widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:clipToPadding="false" android:divider="@null" android:overScrollMode="never" android:scrollbars="none" />
    <TextView android:id="@+id/note_widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fontFamily="@font/plus_jakarta_sans_medium" android:gravity="center" android:padding="8dp" android:text="@string/note_widget_choose_another" android:textColor="@color/quran_widget_secondary" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
