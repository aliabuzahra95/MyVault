<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quran_widget_background"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_semi_bold" android:gravity="center" android:text="Al-Faatiha" android:textColor="@color/quran_widget_text" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/uthmani_hafs" android:gravity="center" android:text="ٱلْفَاتِحَةِ" android:textColor="@color/quran_widget_secondary" android:textDirection="rtl" android:textSize="22sp" />
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@drawable/quran_widget_divider" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fontFamily="@font/uthmani_hafs" android:gravity="end|center_vertical" android:includeFontPadding="true" android:lineSpacingExtra="9dp" android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" android:textColor="@color/quran_widget_text" android:textDirection="rtl" android:textSize="29sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_medium" android:gravity="end" android:text="1:1" android:textColor="@color/quran_widget_accent" android:textSize="11sp" />
</LinearLayout>
