<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quran_widget_dialog_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"
            android:text="@string/quran_widget_search_surahs"
            android:textColor="@color/quran_widget_text"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/quran_widget_search_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/quran_widget_icon_touch"
            android:contentDescription="@string/quran_widget_close_search"
            android:padding="12dp"
            android:src="@drawable/ic_widget_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/quran_widget_search_input"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/quran_widget_search_field"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:hint="@string/quran_widget_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text|textNoSuggestions"
        android:maxLines="1"
        android:paddingHorizontal="15dp"
        android:textColor="@color/quran_widget_text"
        android:textColorHint="@color/quran_widget_secondary"
        android:textDirection="locale"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quran_widget_search_clear"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/quran_widget_setting_touch"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"
            android:gravity="center"
            android:text="@string/quran_widget_clear"
            android:textColor="@color/quran_widget_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/quran_widget_search_apply"
            android:layout_width="88dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/quran_widget_search_apply"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"
            android:gravity="center"
            android:text="@string/quran_widget_search"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
