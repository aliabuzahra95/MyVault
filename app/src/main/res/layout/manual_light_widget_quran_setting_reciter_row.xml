<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/quran_widget_row" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/manual_light_quran_widget_setting_touch" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
