<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quran_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">
    <TextView android:id="@+id/quran_widget_surah_number" android:layout_width="36dp" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_semi_bold" android:gravity="start|center_vertical" android:textColor="@color/quran_widget_accent" android:textSize="13sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
        <TextView android:id="@+id/quran_widget_surah_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/plus_jakarta_sans_semi_bold" android:maxLines="1" android:textColor="@color/quran_widget_text" android:textSize="15sp" />
        <TextView android:id="@+id/quran_widget_surah_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/plus_jakarta_sans_medium" android:maxLines="1" android:textColor="@color/quran_widget_secondary" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/quran_widget_surah_arabic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/uthmani_hafs" android:gravity="end|center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/quran_widget_text" android:textDirection="rtl" android:textSize="24sp" />
</LinearLayout>
