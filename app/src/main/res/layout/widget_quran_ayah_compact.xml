<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quran_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="7dp"
    android:paddingTop="8dp"
    android:paddingBottom="7dp">
    <TextView android:id="@+id/quran_widget_ayah_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/uthmani_hafs" android:gravity="right" android:includeFontPadding="true" android:lineSpacingExtra="5dp" android:textColor="@color/quran_widget_text" android:textDirection="rtl" android:textSize="24sp" />
    <TextView android:id="@+id/quran_widget_translation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textDirection="ltr" android:gravity="left" android:fontFamily="@font/plus_jakarta_sans_medium" android:lineSpacingExtra="2dp" android:paddingTop="5dp" android:textColor="@color/quran_widget_secondary" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/quran_widget_ayah_reference" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans_medium" android:gravity="right" android:paddingTop="2dp" android:textColor="@color/quran_widget_accent" android:textSize="10sp" />
</LinearLayout>
